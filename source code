#include <iostream>
#include <cmath>
#include <iomanip>

using namespace std;

/**
 * @brief Вычисляет значение A по заданной формуле
 * @param x Входное значение x
 * @param y Входное значение y
 * @param z Входное значение z
 * @return Результат вычисления A
 */
double calculateA(const double x, const double y, const double z);

/**
 * @brief Вычисляет значение B по заданной формуле
 * @param x Входное значение x
 * @param y Входное значение y
 * @param z Входное значение z
 * @return Результат вычисления B
 */
double calculateB(const double x, const double y, const double z);

int main()
{
    // Исходные данные
    const double x = 2.0;
    const double y = 0.7;
    const double z = -1.0;
    
    // Устанавливаем точность вывода
    cout << fixed << setprecision(4);
    
    // Вычисляем и выводим результаты
    cout << "Результаты вычислений:" << endl;
    cout << "A = " << calculateA(x, y, z) << endl;
    cout << "B = " << calculateB(x, y, z) << endl;
    
    return 0;
}

double calculateA(const double x, const double y, const double z)
{
    const double expression = x * y * z + fabs(z * sin(y));
    return cbrt(expression); // Используем cbrt вместо pow для вычисления кубического корня
}

double calculateB(const double x, const double y, const double z)
{
    const double argument = x * z * sin(y);
    return y * cos(argument) + 3.0;
}
